   "type": "verse",
   "stanzas": [
    [
     {
      "lines": [
       {
        "text": "ខ្ញុំមិនរស់ដោយអ្វីខ្ញុំមើលឃើញ",
        "chords": [
         {
          "at": 0,
          "chord": "A"
         },
         {
          "at": 9,
          "chord": "F#m"
         }
        ]
       },
       {
        "text": "I'm not gonna live by what I see",
        "chords": []
       }
      ]
     },
     {
      "lines": [
       {
        "text": "ខ្ញុំមិនរស់ដោយអារម្មណ៍ខ្ញុំឡើយ",
        "chords": [
         {
          "at": 0,
          "chord": "F#m"
         }
        ]
       },
       {
        "text": "I'm not gonna live by what I feel",
