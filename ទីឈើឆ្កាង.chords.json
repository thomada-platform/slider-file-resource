         },
         {
          "at": 7,
          "chord": "C#m"
         }
        ]
       },
       {
        "text": "Oh, Lord, You've searched me",
        "chords": []
       }
      ]
     },
     {
      "lines": [
       {
        "text": "ពីជម្រៅចិត្តខ្ញុំ",
