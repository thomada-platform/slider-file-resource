          "chord": "B"
         },
         {
          "at": 7,
          "chord": "C#m"
         }
        ]
       },
       {
        "text": "Even when I fail You",
        "chords": []
       }
      ]
     },
     {
      "lines": [
       {
        "text": "ខ្ញុំដឹងទ្រង់ស្រឡាញ់ខ្ញុំ",
