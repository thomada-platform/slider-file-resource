  {
   "id": "Chorus#1",
   "label": "Chorus",
   "type": "chorus",
   "stanzas": [
    [
     {
      "lines": [
       {
        "text": "ទីឈើឆ្កាងខ្ញុំលត់ជង្គង់",
        "chords": [
         {
          "at": 0,
          "chord": "E"
         },
         {
          "at": 7,
          "chord": "C#m"
         }
        ]
       },
       {
        "text": "At the cross, I bow my knee",
        "chords": []
       }
      ]
     },
     {
      "lines": [
       {
        "text": "ទីដែលទ្រង់សុគតជួសខ្ញុំ",
        "chords": [
         {
          "at": 10,
          "chord": "A"
         }
        ]
       },
       {
        "text": "Where Your blood was shed for me",
        "chords": []
       }
      ]
     },
     {
      "lines": [
       {
        "text": "រកក្តីស្នេហ៍ឯណាប្រៀបស្មើ",
        "chords": [
         {
          "at": 9,
          "chord": "B"
         }
        ]
       },
       {
        "text": "There's no greater love than this",
        "chords": []
       }
      ]
     },
     {
      "lines": [
       {
        "text": "ព្រះអង្គបានឈ្នះលើក្តីស្លាប់",
        "chords": [
         {
          "at": 0,
          "chord": "E"
         },
         {
          "at": 8,
          "chord": "C#m"
         }
        ]
       },
       {
        "text": "You have overcome the grave",
        "chords": []
       }
      ]
     },
     {
      "lines": [
       {
        "text": "ស្ថានសួគ៏ពេញដោយរស្មីទ្រង់",
        "chords": [
         {
          "at": 10,
          "chord": "A"
         }
        ]
       },
       {
        "text": "Glory fills the highest praise",
        "chords": []
       }
      ]
     },
     {
      "lines": [
       {
        "text": "គ្មានអ្វីបំបែកយើងបានឡើយ",
        "chords": [
         {
          "at": 10,
          "chord": "B"
         }
        ]
       },
       {
        "text": "What can separate me now?",
        "chords": []
       }
      ]
     }
    ]
