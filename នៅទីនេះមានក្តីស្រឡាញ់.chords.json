 "sections": [
  {
   "id": "Verse#1",
   "label": "Verse",
   "type": "verse",
   "stanzas": [
    [
     {
      "lines": [
       {
        "text": "នៅកន្លែងនេះ មានក្តីស្រឡាញ់",
        "chords": [
         {
          "at": 0,
          "chord": "D"
         },
         {
          "at": 9,
          "chord": "F#m"
         }
        ]
       }
      ]
     },
     {
      "lines": [
       {
        "text": "នៅកន្លែងនេះខ្ញុំបានជ្រះស្អាត",
        "chords": []
       }
      ]
     },
     {
      "lines": [
       {
        "text": "នៅកន្លែងនេះ ខ្ញុំបានជាសះស្បើយ",
        "chords": []
       }
      ]
     },
     {
      "lines": [
       {
        "text": "សូមព្រះវិញ្ញាណទ្រង់ ហូរមកលើខ្ញុំ",
        "chords": []
       }
      ]
     }
    ]
   ],
   "notes": [],
   "chordRows": []
  },
  {
   "id": "Chorus#1",
   "label": "Chorus",
   "type": "chorus",
   "stanzas": [
    [
     {
      "lines": [
       {
        "text": "ព្រោះនៅទីនេះ ខ្ញុំជាកម្មសិទ្ធិទ្រង់",
        "chords": []
       }
      ]
     },
     {
      "lines": [
       {
        "text": "សូមព្រះអង្គសង់ដំណាក់ទ្រង់ក្នុងចិត្តខ្ញុំ",
        "chords": []
       }
      ]
     },
     {
      "lines": [
       {
        "text": "បំពេញខ្ញុំ ដោយក្តីស្នេហ៍និងក្តីមេត្តា",
        "chords": []
       }
      ]
     },
     {
      "lines": [
       {
        "text": "នៅទីនេះ ក្តីស្រឡាញ់ទ្រង់ល្អអស្ចា្យ",
        "chords": []
       }
      ]
     }
    ]
   ],
   "notes": [],
   "chordRows": []
  }
 ]
}
